
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=your-database
AZURE_SQL_USERNAME=your-user
AZURE_SQL_PASSWORD=your-password

# LLM provider: "openai" (any OpenAI-compatible endpoint, e.g. GitHub Models) or "gemini"
LLM_PROVIDER=openai
LLM_ENDPOINT=https://models.github.ai/inference/chat/completions
LLM_TOKEN=your-token
LLM_MODEL=openai/gpt-4.1-mini

# Used when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
